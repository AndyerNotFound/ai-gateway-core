<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>卡密管理</title>
<style>
@font-face{font-family:'Material Symbols Outlined';font-style:normal;font-weight:400;font-display:block;src:url('/admin/assets/material-symbols-outlined.woff2') format('woff2')}
.msym{font-family:'Material Symbols Outlined';font-weight:normal;font-style:normal;font-size:20px;line-height:1;letter-spacing:normal;text-transform:none;display:inline-block;white-space:nowrap;direction:ltr;-webkit-font-smoothing:antialiased;user-select:none;vertical-align:middle}

:root{
  --md-sys-color-primary:#D0BCFF; --md-sys-color-on-primary:#381E72;
  --md-sys-color-primary-container:#4F378B; --md-sys-color-on-primary-container:#EADDFF;
  --md-sys-color-secondary-container:#4A4458; --md-sys-color-on-secondary-container:#E8DEF8;
  --md-sys-color-error-container:#8B1A1A; --md-sys-color-on-error-container:#F9DEDC;
  --md-sys-color-surface:#141218; --md-sys-color-on-surface:#E6E1E5;
  --md-sys-color-surface-container:#211F26; --md-sys-color-surface-container-high:#2B2930; --md-sys-color-surface-container-highest:#36343B;
  --md-sys-color-on-surface-variant:#CAC4D0; --md-sys-color-outline:#938F99; --md-sys-color-outline-variant:#49454F;
  --font:system-ui,-apple-system,'Segoe UI',Roboto,'Noto Sans SC',sans-serif;
  --mono:ui-monospace,'SF Mono',Consolas,monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--md-sys-color-surface);color:var(--md-sys-color-on-surface);font-family:var(--font);font-size:14px;line-height:1.5;padding:16px}
input,select{font-family:var(--font);font-size:14px;color:var(--md-sys-color-on-surface);background:var(--md-sys-color-surface-container-highest);border:1px solid var(--md-sys-color-outline-variant);border-radius:8px;padding:8px 12px;outline:none;width:100%}
input:focus{border-color:var(--md-sys-color-primary)}
button{font-family:var(--font);cursor:pointer;border:none;background:none;color:inherit}
.card{background:var(--md-sys-color-surface-container);border:1px solid var(--md-sys-color-outline-variant);border-radius:16px;padding:16px;margin-bottom:14px}
.card h3{font-size:15px;font-weight:600;margin-bottom:10px}
.btn{display:inline-flex;align-items:center;gap:5px;height:34px;padding:0 14px;border-radius:999px;font-size:13px;font-weight:600}
.btn-filled{background:var(--md-sys-color-primary);color:var(--md-sys-color-on-primary)}
.btn-tonal{background:var(--md-sys-color-secondary-container);color:var(--md-sys-color-on-secondary-container)}
.btn-danger{background:var(--md-sys-color-error-container);color:var(--md-sys-color-on-error-container)}
.btn-sm{height:28px;padding:0 10px;font-size:12px}
table{width:100%;border-collapse:collapse;font-size:12.5px}
th{text-align:left;color:var(--md-sys-color-on-surface-variant);font-weight:600;padding:8px 6px;border-bottom:1px solid var(--md-sys-color-outline-variant);white-space:nowrap}
td{padding:8px 6px;border-bottom:1px solid var(--md-sys-color-outline-variant);vertical-align:middle}
tr:last-child td{border-bottom:none}
.mono{font-family:var(--mono);font-size:11.5px}
.badge{display:inline-flex;align-items:center;height:20px;padding:0 8px;border-radius:999px;font-size:11px;font-weight:600}
.badge.ok{background:#1b5e20;color:#c8e6c9}
.badge.off{background:var(--md-sys-color-surface-variant);color:var(--md-sys-color-on-surface-variant)}
.badge.exp{background:var(--md-sys-color-error-container);color:var(--md-sys-color-on-error-container)}
.frow{margin-bottom:10px}
.frow label{display:block;font-size:12px;font-weight:600;color:var(--md-sys-color-on-surface-variant);margin-bottom:4px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
#toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:#E6E0E9;color:#322F35;padding:9px 18px;border-radius:10px;font-size:13px;opacity:0;pointer-events:none;transition:.2s;z-index:60}
#toast.on{opacity:1}
#toast.err{background:var(--md-sys-color-error-container);color:var(--md-sys-color-on-error-container)}
.empty{color:var(--md-sys-color-on-surface-variant);text-align:center;padding:24px;font-size:13px}
.tblwrap{overflow-x:auto}
.pbar{height:5px;border-radius:3px;background:var(--md-sys-color-surface-variant);overflow:hidden;min-width:60px}
.pbar i{display:block;height:100%;background:var(--md-sys-color-primary);border-radius:3px}
/* 窄屏: 表格转卡片式(每卡一行数据, 字段竖排带标签) */
@media(max-width:680px){
  .tblwrap table,.tblwrap tbody,.tblwrap tr,.tblwrap td{display:block;width:100%}
  .tblwrap thead{display:none}
  .tblwrap tr{border:1px solid var(--md-sys-color-outline-variant);border-radius:12px;margin-bottom:10px;padding:10px 12px;background:var(--md-sys-color-surface-container-high)}
  .tblwrap td{border-bottom:none;padding:4px 0}
  .tblwrap td::before{content:attr(data-l);display:block;font-size:11px;color:var(--md-sys-color-on-surface-variant);margin-bottom:1px}
  .tblwrap td[data-l=""]::before{display:none}
  .tblwrap td:last-child{padding-top:8px}
}
</style>
</head>
<body>

<div class="card">
  <h3><span class="msym" style="font-size:18px">confirmation_number</span> 发卡</h3>
  <div class="g2">
    <div class="frow"><label>名称</label><input id="k_name" placeholder="例如: 用户A"></div>
    <div class="frow"><label>额度 (tokens, 0=不限)</label><input id="k_quota" type="number" placeholder="0"></div>
    <div class="frow"><label>到期时间 (可留空)</label><input id="k_exp" placeholder="2026-12-31 或 ISO"></div>
    <div class="frow"><label>备注</label><input id="k_note" placeholder="可留空"></div>
  </div>
  <button class="btn btn-filled" onclick="createKey()"><span class="msym" style="font-size:16px">auto_awesome</span> 生成卡密</button>
</div>

<div class="card">
  <h3><span class="msym" style="font-size:18px">format_list_bulleted</span> 卡密列表 <button class="btn btn-tonal btn-sm" style="margin-left:8px" onclick="load()"><span class="msym" style="font-size:16px">refresh</span> 刷新</button></h3>
  <div class="tblwrap"><table>
    <thead><tr><th>名称</th><th>卡密</th><th>用量</th><th>状态</th><th>到期</th><th>操作</th></tr></thead>
    <tbody id="tbody"><tr><td colspan="6" class="empty">加载中…</td></tr></tbody>
  </table></div>
</div>

<div id="toast"></div>

<script>
'use strict';
const $=id=>document.getElementById(id);
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toast(m,e){const t=$('toast');t.textContent=m;t.className='on'+(e?' err':'');clearTimeout(t._tm);t._tm=setTimeout(()=>t.className='',2400)}
function fmtTok(n){n=n||0;if(n>=1e8)return(n/1e8).toFixed(2)+'亿';if(n>=1e4)return(n/1e4).toFixed(1)+'万';return String(n)}
const BASE = location.pathname.replace(/\/pages\/.*$/, ''); // /plugins/auth-cardkey
async function api(p, opts={}){
  if (opts.body && typeof opts.body==='object'){opts.headers=Object.assign({'Content-Type':'application/json'},opts.headers||{});opts.body=JSON.stringify(opts.body);}
  const r = await fetch(BASE+p, opts);
  const j = await r.json().catch(()=>null);
  if (!r.ok) throw new Error((j&&j.error)||('HTTP '+r.status));
  return j;
}
function isExpired(k){ if(!k.expiresAt) return false; const t=Date.parse(k.expiresAt); return !isNaN(t) && t < Date.now(); }
async function load(){
  try {
    const r = await api('/admin/keys');
    const ks = r.keys||[];
    if (!ks.length){ $('tbody').innerHTML='<tr><td colspan="6" class="empty">还没有卡密, 先签一个</td></tr>'; return; }
    $('tbody').innerHTML = ks.map(k=>{
      const exp = isExpired(k);
      const pct = k.quotaTokens>0 ? Math.min(100, (k.usedTokens||0)/k.quotaTokens*100) : 0;
      const st = exp?'<span class="badge exp">已过期</span>':(k.enable?'<span class="badge ok">正常</span>':'<span class="badge off">禁用</span>');
      return '<tr>'
        +'<td data-l=""><b>'+esc(k.name)+'</b>'+(k.note?'<div style="font-size:11px;color:var(--md-sys-color-on-surface-variant)">'+esc(k.note)+'</div>':'')+'</td>'
        +'<td data-l="卡密" class="mono">'+esc(k.key.slice(0,10))+'… <button class="btn btn-tonal btn-sm" onclick="cp(\''+esc(k.key)+'\')">复制</button></td>'
        +'<td data-l="用量" style="min-width:90px">'+fmtTok(k.usedTokens)+' / '+(k.quotaTokens===-1?'0':(k.quotaTokens>0?fmtTok(k.quotaTokens):'∞'))+'<div class="pbar"><i style="width:'+pct+'%"></i></div></td>'
        +'<td data-l="状态">'+st+'</td>'
        +'<td data-l="到期" style="font-size:11.5px">'+(k.expiresAt?esc(k.expiresAt.slice(0,10)):'—')+'</td>'
        +'<td data-l="" style="white-space:nowrap">'
        +'<button class="btn btn-tonal btn-sm" onclick="recharge(\''+esc(k.key)+'\')">充值</button> '
        +'<button class="btn btn-tonal btn-sm" onclick="toggle(\''+esc(k.key)+'\','+(!k.enable)+')">'+(k.enable?'禁用':'启用')+'</button> '
        +'<button class="btn btn-danger btn-sm" onclick="del(\''+esc(k.key)+'\',\''+esc(k.name)+'\')">删</button></td></tr>';
    }).join('');
  } catch(e){ $('tbody').innerHTML='<tr><td colspan="6" class="empty">'+esc(e.message)+'</td></tr>'; }
}
function cp(k){ (navigator.clipboard?navigator.clipboard.writeText(k):Promise.reject()).then(()=>toast('已复制')).catch(()=>{prompt('手动复制:',k)}); }
async function createKey(){
  try {
    const r = await api('/admin/keys', {method:'POST', body:{name:$('k_name').value.trim()||'卡密', quotaTokens:Number($('k_quota').value)||0, expiresAt:$('k_exp').value.trim(), note:$('k_note').value.trim()}});
    toast('已签发: '+r.key.key.slice(0,14)+'…');
    $('k_name').value=''; $('k_quota').value=''; $('k_exp').value=''; $('k_note').value='';
    load();
  } catch(e){ toast(e.message, true); }
}
async function recharge(key){
  const v = prompt('充值额度 (tokens, 加到现有额度上):', '100000'); if(!v) return;
  try { await api('/admin/keys-update', {method:'POST', body:{key, addQuota:Number(v)}}); toast('已充值'); load(); } catch(e){ toast(e.message, true); }
}
async function toggle(key, enable){
  try { await api('/admin/keys-update', {method:'POST', body:{key, enable}}); toast(enable?'已启用':'已禁用'); load(); } catch(e){ toast(e.message, true); }
}
async function del(key, name){
  if (!confirm('确定删除卡密「'+name+'」?\n'+key.slice(0,16)+'…')) return;
  try { await api('/admin/keys', {method:'DELETE', body:{key}}); toast('已删除'); load(); } catch(e){ toast(e.message, true); }
}
load();
</script>
</body>
</html>
