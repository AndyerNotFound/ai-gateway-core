{
  "id": "auth-cardkey",
  "name": "卡密认证",
  "version": "1.4.0",
  "type": "auth",
  "icon": "msym:key",
  "description": "卡密(API Key)认证: 发卡/额度/过期/模型·分组·实例白名单, /credits 余额查询。额度口径 = 动态计费(billing)的加权额度；预授权冻结走 billing 的 onQuotaEstimate 换算（估不出来才回退 1 token = 1 额度 的老口径）。",
  "hasServer": true,
  "adminPage": "pages/admin.html",
  "permissions": [
    "auth:registerAuth",
    "gateway:registerGlobalKey",
    "gateway:topRoute",
    "storage",
    "gateway:modelGroups",
    "gateway:listInstances",
    "gateway:adminUi"
  ],
  "configSchema": [
    {
      "key": "keyLength",
      "label": "卡密长度(8-128)",
      "type": "number",
      "default": 24
    }
  ],
  "dataScope": "global"
}
