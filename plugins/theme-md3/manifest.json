      "onSurfaceVariant": "#CAC4D0",
      "outline": "#938F99",
      "error": "#F2B8B5",
      "onError": "#601410"
    },
    "light": {
      "primary": "#6750A4",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#EADDFF",
      "onPrimaryContainer": "#21005D",
      "secondary": "#625B71",
      "onSecondary": "#FFFFFF",
      "secondaryContainer": "#E8DEF8",
