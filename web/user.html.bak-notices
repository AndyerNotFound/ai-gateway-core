<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>用户中心 · AI Gateway</title>
<style>
@font-face{font-family:'Material Symbols Outlined';font-style:normal;font-weight:400;font-display:block;src:url('/admin/assets/material-symbols-outlined.woff2') format('woff2')}
.msym{font-family:'Material Symbols Outlined';font-weight:normal;font-style:normal;font-size:20px;line-height:1;letter-spacing:normal;text-transform:none;display:inline-block;white-space:nowrap;direction:ltr;-webkit-font-smoothing:antialiased;user-select:none;vertical-align:middle}

:root{
  --md-sys-color-primary:#D0BCFF; --md-sys-color-on-primary:#381E72;
  --md-sys-color-primary-container:#4F378B; --md-sys-color-on-primary-container:#EADDFF;
  --md-sys-color-secondary-container:#4A4458; --md-sys-color-on-secondary-container:#E8DEF8;
  --md-sys-color-tertiary-container:#633B48; --md-sys-color-on-tertiary-container:#FFD8E4;
  --md-sys-color-error-container:#8B1A1A; --md-sys-color-on-error-container:#F9DEDC;
  --md-sys-color-surface:#141218; --md-sys-color-on-surface:#E6E1E5;
  --md-sys-color-surface-container:#211F26; --md-sys-color-surface-container-high:#2B2930; --md-sys-color-surface-container-highest:#36343B;
  --md-sys-color-surface-container-low:#1D1B20;
  --md-sys-color-on-surface-variant:#CAC4D0; --md-sys-color-outline:#938F99; --md-sys-color-outline-variant:#49454F;
  --font:system-ui,-apple-system,'Segoe UI',Roboto,'Noto Sans SC',sans-serif;
  --mono:ui-monospace,'SF Mono',Consolas,monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-tap-highlight-color:transparent}
body{background:var(--md-sys-color-surface);color:var(--md-sys-color-on-surface);font-family:var(--font);font-size:14px;line-height:1.5;min-height:100dvh}
.topbar{display:flex;align-items:center;gap:10px;padding:14px 16px;background:var(--md-sys-color-surface-container);border-bottom:1px solid var(--md-sys-color-outline-variant);position:sticky;top:0;z-index:10}
.topbar .logo{width:34px;height:34px;border-radius:10px;background:var(--md-sys-color-primary-container);color:var(--md-sys-color-on-primary-container);display:grid;place-items:center;font-size:17px}
.topbar .t{font-size:16px;font-weight:600}
.topbar .sub{font-size:11px;color:var(--md-sys-color-on-surface-variant)}
.main{max-width:640px;margin:0 auto;padding:16px 14px 40px}
.card{background:var(--md-sys-color-surface-container);border:1px solid var(--md-sys-color-outline-variant);border-radius:16px;padding:16px;margin-bottom:14px}
.card h3{font-size:15px;font-weight:600;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.sub{font-size:12px;color:var(--md-sys-color-on-surface-variant)}
input,select,textarea{font-family:var(--font);font-size:14px;color:var(--md-sys-color-on-surface);background:var(--md-sys-color-surface-container-highest);border:1px solid var(--md-sys-color-outline-variant);border-radius:10px;padding:10px 13px;outline:none;width:100%}
input:focus,select:focus,textarea:focus{border-color:var(--md-sys-color-primary);box-shadow:0 0 0 1px var(--md-sys-color-primary)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:40px;padding:0 20px;border-radius:999px;font-size:14px;font-weight:600;border:none;cursor:pointer;font-family:var(--font)}
.btn-fill{background:var(--md-sys-color-primary);color:var(--md-sys-color-on-primary)}
.btn-tonal{background:var(--md-sys-color-secondary-container);color:var(--md-sys-color-on-secondary-container)}
.btn-danger{background:var(--md-sys-color-error-container);color:var(--md-sys-color-on-error-container)}
.btn-sm{height:30px;padding:0 12px;font-size:12.5px}
.btn:disabled{opacity:.5;pointer-events:none}
.frow{margin-bottom:12px}
.frow label{display:block;font-size:12.5px;font-weight:600;color:var(--md-sys-color-on-surface-variant);margin-bottom:5px}
.tabs{display:flex;gap:6px;margin-bottom:14px;background:var(--md-sys-color-surface-container-low);border-radius:999px;padding:4px}
.tabs button{flex:1;height:36px;border:none;border-radius:999px;background:transparent;color:var(--md-sys-color-on-surface-variant);font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font);transition:.15s}
.tabs button.on{background:var(--md-sys-color-secondary-container);color:var(--md-sys-color-on-secondary-container)}
.quota-big{font-size:38px;font-weight:700;color:var(--md-sys-color-primary);font-variant-numeric:tabular-nums;line-height:1.1}
.quota-bar{height:8px;border-radius:4px;background:var(--md-sys-color-surface-variant);overflow:hidden;margin:12px 0 8px}
.quota-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--md-sys-color-primary),var(--md-sys-color-tertiary-container));border-radius:4px;transition:width .5s}
.kv{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--md-sys-color-outline-variant);font-size:13.5px}
.kv:last-child{border-bottom:none}
.kv .k{color:var(--md-sys-color-on-surface-variant)}
.kv .v{font-weight:500;text-align:right;word-break:break-all;max-width:60%}
.mrow{display:flex;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid var(--md-sys-color-outline-variant)}
.mrow:last-child{border-bottom:none}
.mrow .grow{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--mono);font-size:13px}
.badge{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:999px;font-size:11px;font-weight:600;flex:none}
.badge.ok{background:#1b5e20;color:#c8e6c9}
.badge.off{background:var(--md-sys-color-surface-variant);color:var(--md-sys-color-on-surface-variant)}
.badge.warn{background:var(--md-sys-color-tertiary-container);color:var(--md-sys-color-on-tertiary-container)}
.empty{color:var(--md-sys-color-on-surface-variant);text-align:center;padding:28px 12px;font-size:13px}
.mono{font-family:var(--mono);font-size:12px;word-break:break-all}
#toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%);background:#E6E0E9;color:#322F35;padding:11px 22px;border-radius:10px;font-size:13.5px;opacity:0;pointer-events:none;transition:.22s;z-index:60;max-width:86vw;text-align:center}
#toast.on{opacity:1}
#toast.err{background:var(--md-sys-color-error-container);color:var(--md-sys-color-on-error-container)}
.avatar{width:48px;height:48px;border-radius:50%;background:var(--md-sys-color-primary-container);color:var(--md-sys-color-on-primary-container);display:grid;place-items:center;font-size:20px;font-weight:700;flex:none;overflow:hidden}
.avatar img{width:100%;height:100%;object-fit:cover}
iframe.plugin-frame{width:100%;border:none;border-radius:14px;background:var(--md-sys-color-surface-container-low);min-height:60vh}
.search{display:flex;gap:8px;margin-bottom:10px}
.row{display:flex;gap:8px;align-items:center}
</style>
</head>
<body>

<div class="topbar">
  <div class="logo">◈</div>
  <div><div class="t">AI Gateway</div><div class="sub" id="topSub">用户中心</div></div>
</div>

<div class="main">
  <!-- 登录 -->
  <div id="loginBox">
    <div class="card">
      <h3>登录</h3>
      <div class="tabs">
        <button id="tabKey" class="on">卡密登录</button>
        <button id="tabAcct">账号登录</button>
        <button id="tabReg" hidden>注册</button>
      </div>
      <div id="loginKey">
        <div class="frow"><label>卡密 (sk-...)</label><input id="lk_key" placeholder="sk-xxxxxxxx"></div>
        <button class="btn btn-fill" style="width:100%" id="btnKeyLogin">进入</button>
      </div>
      <div id="loginAcct" hidden>
        <div class="frow"><label>用户名</label><input id="la_uid" placeholder="用户名"></div>
        <div class="frow"><label>密码</label><input id="la_pw" type="password" placeholder="密码"></div>
        <button class="btn btn-fill" style="width:100%" id="btnAcctLogin">登录</button>
        <div class="sub" style="margin-top:10px" id="regHint"></div>
      </div>
      <div id="loginReg" hidden>
        <div class="frow"><label>用户名</label><input id="rg_uid" placeholder="3-32位字母数字下划线"></div>
        <div class="frow"><label>密码</label><input id="rg_pw" type="password" placeholder="至少8位"></div>
        <div class="frow"><label>确认密码</label><input id="rg_pw2" type="password"></div>
        <div id="rgEmailBox" hidden>
          <div class="frow"><label>邮箱</label><input id="rg_email" type="email" placeholder="name@example.com"></div>
          <div class="frow"><label>验证码</label>
            <div class="row" style="gap:8px"><input id="rg_code" placeholder="6位验证码" style="flex:1"><button class="btn btn-tonal" id="btnSendCode">发送</button></div>
          </div>
        </div>
        <div id="rgCaptchaBox" style="margin:8px 0"></div>
        <button class="btn btn-fill" style="width:100%" id="btnRegister">注册并登录</button>
      </div>
    </div>
  </div>

  <!-- 已登录 -->
  <div id="appBox" hidden>
    <div class="card">
      <div class="row" style="margin-bottom:4px">
        <div class="avatar" id="uAvatar">?</div>
        <div style="flex:1;min-width:0">
          <div style="font-weight:600;font-size:15px" id="uName">-</div>
          <div class="sub mono" id="uKey"></div>
        </div>
        <button class="btn btn-tonal btn-sm" id="btnSettings" title="账号设置"><span class="msym" style="font-size:16px">settings</span></button>
        <button class="btn btn-tonal btn-sm" id="btnLogout">退出</button>
      </div>
      <div id="acctSettings" hidden style="margin-top:12px;border-top:1px dashed var(--md-sys-color-outline-variant,#49454F);padding-top:12px">
        <div class="frow"><label>昵称</label><input id="as_nick"></div>
        <div class="frow"><label>头像 URL</label><input id="as_avatar" placeholder="https://..."></div>
        <button class="btn btn-tonal btn-sm" id="btnSaveProfile">保存资料</button>
        <div style="margin:14px 0 6px;font-weight:600;font-size:13px">修改密码</div>
        <div class="frow"><label>原密码</label><input id="as_oldpw" type="password"></div>
        <div class="frow"><label>新密码</label><input id="as_newpw" type="password" placeholder="至少8位"></div>
        <button class="btn btn-fill btn-sm" id="btnChangePw">改密码</button>
      </div>
    </div>

    <div class="tabs" id="appTabs">
      <button data-t="home" class="on">首页</button>
      <button data-t="models">模型</button>
      <button data-t="keys">卡密</button>
      <button data-t="plugins" id="tabPlugins" hidden>插件</button>
    </div>

    <div id="page-home">
      <div class="card">
        <h3>额度</h3>
        <div id="quotaArea"><div class="empty">加载中…</div></div>
      </div>
      <div class="card"><h3>账号信息</h3><div id="meArea"><div class="empty">加载中…</div></div></div>
    </div>

    <div id="page-models" hidden>
      <div class="card">
        <h3>可用模型</h3>
        <div class="search"><input id="modelQ" placeholder="搜索模型名…"></div>
        <div id="modelList"><div class="empty">加载中…</div></div>
      </div>
    </div>

    <div id="page-keys" hidden>
      <div class="card">
        <h3>发子卡</h3>
        <div class="frow"><label>名称</label><input id="nk_name" placeholder="例如: 手机用"></div>
        <div class="frow"><label>额度 (tokens, 0=跟随主卡剩余)</label><input id="nk_quota" type="number" placeholder="0"></div>
        <div class="frow"><label>限定模型 (逗号分隔, 空=不限制)</label><input id="nk_models" placeholder="deepseek-chat"></div>
        <button class="btn btn-fill" id="btnNewKey" style="width:100%">签发</button>
      </div>
      <div class="card"><h3>我的卡密</h3><div id="keyList"><div class="empty">加载中…</div></div></div>
    </div>

    <div id="page-plugins" hidden>
      <div class="card" id="pluginCards"><div class="empty">加载中…</div></div>
      <div id="pluginFrameBox" hidden><div class="card" style="padding:8px"><iframe class="plugin-frame" id="pluginFrame"></iframe></div></div>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
'use strict';
const $ = id => document.getElementById(id);
const esc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function toast(m,e){const t=$('toast');t.textContent=m;t.className='on'+(e?' err':'');clearTimeout(t._tm);t._tm=setTimeout(()=>t.className='',2400)}
function fmtTok(n){n=Number(n)||0;if(n>=1e8)return(n/1e8).toFixed(2)+'亿';if(n>=1e4)return(n/1e4).toFixed(2)+'万';return String(n)}
/* 分支感知: 页面在 /<branch>/user 时 API 自动带前缀 */
const BASE = location.pathname.replace(/\/user\/?$/, '/').replace(/^\/+/, '/');
const apiBase = BASE; // '/user' → '/' ; '/bs2/user' → '/bs2/'

let token = localStorage.getItem('agw_user_token') || '';
let meInfo = null;

async function api(p, opts={}){
  opts.headers = Object.assign({}, opts.headers||{});
  if (token) opts.headers['authorization'] = 'Bearer '+token;
  if (opts.body && typeof opts.body==='object'){opts.headers['Content-Type']='application/json';opts.body=JSON.stringify(opts.body);}
  const r = await fetch(apiBase + p.replace(/^\//,''), opts);
  const j = await r.json().catch(()=>null);
  if (!r.ok) throw new Error((j && (j.error && j.error.message || j.error)) || ('HTTP '+r.status));
  return j;
}

/* ---------- 登录 ---------- */
let regCfg = null, captchaToken = '';
function switchLoginTab(which){
  $('tabKey').classList.toggle('on', which==='key');
  $('tabAcct').classList.toggle('on', which==='acct');
  $('tabReg').classList.toggle('on', which==='reg');
  $('loginKey').hidden = which!=='key'; $('loginAcct').hidden = which!=='acct'; $('loginReg').hidden = which!=='reg';
}
$('tabKey').onclick = ()=>switchLoginTab('key');
$('tabAcct').onclick = ()=>switchLoginTab('acct');
$('tabReg').onclick = ()=>switchLoginTab('reg');

async function checkRegInfo(){
  try {
    const r = await fetch(apiBase+'auth/register').then(r=>r.json());
    regCfg = r || null;
    if (r && r.enable) {
      $('tabReg').hidden = false;
      $('regHint').textContent = '';
      if (r.emailVerify) $('rgEmailBox').hidden = false;
      if (r.captchaSiteKey) loadTurnstile(r.captchaSiteKey);
    } else { $('regHint').textContent = ''; }
    function loadTurnstile(siteKey){
      const sc = document.createElement('script');
      sc.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?onload=_tsReady'; sc.async = true;
      window._tsReady = ()=>{ try{ window.turnstile.render('#rgCaptchaBox', { sitekey: siteKey, callback: t=>{ captchaToken = t; } }); }catch(_){} };
      document.head.appendChild(sc);
    }
  } catch(_){ $('tabAcct').style.display='none'; }
}
$('btnKeyLogin').onclick = async ()=>{
  const k = $('lk_key').value.trim(); if(!k) return toast('请输入卡密', true);
  token = k;
  try { await api('credits'); localStorage.setItem('agw_user_token', k); enter(); }
  catch(e){ token=''; toast('卡密无效: '+e.message, true); }
};
$('btnAcctLogin').onclick = async ()=>{
  const uid=$('la_uid').value.trim(), pw=$('la_pw').value;
  if(!uid||!pw) return toast('请输入用户名和密码', true);
  try {
    const r = await fetch(apiBase+'auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:uid,password:pw})}).then(r=>r.json());
    if (!r.ok) throw new Error(r.error||'登录失败');
    const main = (r.keys||[])[0];
    if (!main) throw new Error('该账号没有卡密');
    token = main.key; localStorage.setItem('agw_user_token', token);
    toast('欢迎, '+uid); enter();
  } catch(e){ toast(e.message, true); }
};
$('btnLogout').onclick = ()=>{ token=''; localStorage.removeItem('agw_user_token'); location.reload(); };

/* 注册 */
$('btnSendCode').onclick = async ()=>{
  const email = $('rg_email').value.trim();
  if (!email) return toast('请填写邮箱', true);
  $('btnSendCode').disabled = true; let n = 60;
  const tm = setInterval(()=>{ $('btnSendCode').textContent = n>0 ? (n--)+'s' : '发送'; if(n<0){clearInterval(tm);$('btnSendCode').disabled=false;} }, 1000);
  try{ await fetch(apiBase+'auth/email-code', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ email }) }).then(async r=>{ const j=await r.json(); if(!r.ok) throw new Error(j.error||'发送失败'); }); toast('验证码已发送'); }
  catch(e){ toast(e.message, true); clearInterval(tm); $('btnSendCode').disabled=false; $('btnSendCode').textContent='发送'; }
};
$('btnRegister').onclick = async ()=>{
  const uid = $('rg_uid').value.trim(), pw = $('rg_pw').value, pw2 = $('rg_pw2').value;
  if (!uid || !pw) return toast('用户名和密码必填', true);
  if (pw !== pw2) return toast('两次密码不一致', true);
  const body = { username: uid, password: pw };
  if (regCfg && regCfg.emailVerify){ body.email = $('rg_email').value.trim(); body.emailCode = $('rg_code').value.trim();
    if (!body.email || !body.emailCode) return toast('请填写邮箱和验证码', true); }
  if (captchaToken) body.captchaToken = captchaToken;
  try{
    const r = await fetch(apiBase+'auth/register', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const j = await r.json();
    if (!r.ok) throw new Error(j.error || '注册失败');
    token = j.key; localStorage.setItem('agw_user_token', token);
    toast('注册成功'); enter();
  }catch(e){ toast(e.message, true); }
};

/* 账号设置 */
$('btnSettings').onclick = ()=>{
  const box = $('acctSettings'); box.hidden = !box.hidden;
  if (!box.hidden && meInfo){ $('as_nick').value = meInfo.nickname || ''; $('as_avatar').value = meInfo.avatar || ''; }
};
$('btnSaveProfile').onclick = async ()=>{
  try{
    const r = await fetch(apiBase+'auth/profile', { method:'POST', headers:{ 'Content-Type':'application/json', 'Authorization':'Bearer '+token }, body: JSON.stringify({ nickname: $('as_nick').value, avatar: $('as_avatar').value }) });
    const j = await r.json(); if (!r.ok) throw new Error(j.error || '保存失败');
    toast('已保存'); enter();
  }catch(e){ toast(e.message, true); }
};
$('btnChangePw').onclick = async ()=>{
  try{
    const r = await fetch(apiBase+'auth/password', { method:'POST', headers:{ 'Content-Type':'application/json', 'Authorization':'Bearer '+token }, body: JSON.stringify({ oldPassword: $('as_oldpw').value, newPassword: $('as_newpw').value }) });
    const j = await r.json(); if (!r.ok) throw new Error(j.error || '修改失败');
    toast('密码已修改'); $('as_oldpw').value=''; $('as_newpw').value='';
  }catch(e){ toast(e.message, true); }
};

/* ---------- 主界面 ---------- */
async function enter(){
  $('loginBox').hidden = true; $('appBox').hidden = false;
  loadHome(); loadModels(); loadKeys(); loadPlugins();
}
for (const b of document.querySelectorAll('#appTabs button')){
  b.onclick = ()=>{
    document.querySelectorAll('#appTabs button').forEach(x=>x.classList.remove('on'));
    b.classList.add('on');
    for (const pg of ['home','models','keys','plugins']) $('page-'+pg).hidden = (pg !== b.dataset.t);
  };
}
async function loadHome(){
  try {
    const c = await api('credits');
    const pct = c.unlimited||!c.quotaTokens ? 0 : Math.min(100, (c.usedTokens||0)/c.quotaTokens*100);
    $('quotaArea').innerHTML =
      '<div class="quota-big">'+(c.unlimited?'∞':fmtTok(c.remainingTokens!=null?c.remainingTokens:(c.quotaTokens-(c.usedTokens||0))))+'</div>'
      +'<div class="sub">剩余 tokens'+(c.unlimited?' (不限量)':((c.remainingTokens===0)?' (已用尽, 请联系管理员充值)':''))+'</div>'
      +'<div class="quota-bar"><i style="width:'+pct+'%"></i></div>'
      +'<div class="kv"><span class="k">已用</span><span class="v">'+fmtTok(c.usedTokens||0)+'</span></div>'
      +'<div class="kv"><span class="k">总额度</span><span class="v">'+(c.quotaTokens?fmtTok(c.quotaTokens):'不限')+'</span></div>'
      +(c.expiresAt?'<div class="kv"><span class="k">到期</span><span class="v">'+esc(c.expiresAt)+'</span></div>':'')
      +(c.models&&c.models.length?'<div class="kv"><span class="k">限定模型</span><span class="v">'+esc(c.models.join(', '))+'</span></div>':'');
    $('uKey').textContent = token.slice(0,10)+'…';
  } catch(e){ $('quotaArea').innerHTML='<div class="empty">'+esc(e.message)+'</div>'; }
  try {
    const m = await api('auth/me');
    meInfo = m;
    $('uName').textContent = m.nickname || m.name || m.uid || '卡密用户';
    if (m.avatar) $('uAvatar').innerHTML = '<img src="'+esc(m.avatar)+'">'; else $('uAvatar').textContent = (m.uid||'K')[0].toUpperCase();
    $('meArea').innerHTML =
      (m.uid?'<div class="kv"><span class="k">UID</span><span class="v">'+esc(m.uid)+'</span></div>':'')
      +'<div class="kv"><span class="k">卡数</span><span class="v">'+((m.keys||[]).length)+'</span></div>'
      +(m.branches&&m.branches.length?'<div class="kv"><span class="k">可访问分组</span><span class="v">'+esc(m.branches.join(', '))+'</span></div>':'');
  } catch(e){
    $('uName').textContent = '卡密用户';
    $('uAvatar').textContent = 'K';
    $('meArea').innerHTML = '<div class="sub">该实例未启用用户体系插件, 仅卡密模式</div>';
  }
}
let allModels = [];
async function loadModels(){
  try {
    const r = await api('v1/models');
    allModels = (r.data||[]).map(m=>m.id||m.name).filter(Boolean);
    renderModels();
  } catch(e){ $('modelList').innerHTML='<div class="empty">'+esc(e.message)+'</div>'; }
}
function renderModels(){
  const q = ($('modelQ').value||'').toLowerCase();
  const list = allModels.filter(m=>!q||m.toLowerCase().includes(q));
  $('modelList').innerHTML = list.map(m=>
    '<div class="mrow"><div class="grow">'+esc(m)+'</div><button class="btn btn-tonal btn-sm" data-cp="'+esc(m)+'">复制</button></div>'
  ).join('') || '<div class="empty">无匹配模型</div>';
}
$('modelQ').addEventListener('input', renderModels);
$('modelList').addEventListener('click', e=>{
  const b = e.target.closest('[data-cp]'); if(!b) return;
  const v = b.getAttribute('data-cp');
  (navigator.clipboard?navigator.clipboard.writeText(v):Promise.reject()).then(()=>toast('已复制 '+v)).catch(()=>prompt('手动复制:',v));
});
async function loadKeys(){
  try {
    const r = await api('auth/mykeys');
    const ks = r.keys||[];
    $('keyList').innerHTML = ks.map(k=>
      '<div class="mrow"><div class="grow"><div style="font-family:var(--font);font-weight:600">'+esc(k.name)+(k.isMain?' <span class="badge warn">主卡</span>':'')+'</div><div class="mono sub">'+esc(k.key.slice(0,12))+'… · 已用 '+fmtTok(k.usedTokens||0)+(k.quotaTokens?' / '+fmtTok(k.quotaTokens):' / ∞')+'</div></div>'
      +'<button class="btn btn-tonal btn-sm" data-cp="'+esc(k.key)+'">复制</button>'
      +(k.isMain?'':'<button class="btn btn-danger btn-sm" data-del="'+esc(k.key)+'">删</button>')+'</div>'
    ).join('') || '<div class="empty">无卡密</div>';
  } catch(e){ $('keyList').innerHTML='<div class="empty">该实例未启用用户体系</div>'; $('page-keys').querySelector('.card').style.display='none'; }
}
$('keyList').addEventListener('click', async e=>{
  const cb = e.target.closest('[data-cp]');
  if (cb){ const v=cb.getAttribute('data-cp'); (navigator.clipboard?navigator.clipboard.writeText(v):Promise.reject()).then(()=>toast('已复制')).catch(()=>prompt('手动复制:',v)); return; }
  const db = e.target.closest('[data-del]');
  if (db){
    if (!confirm('确定删除这张子卡? 删除后该卡立即失效。')) return;
    try { await api('auth/mykeys-delete',{method:'POST',body:{key:db.getAttribute('data-del')}}); toast('已删除'); loadKeys(); loadHome(); }
    catch(e2){ toast(e2.message, true); }
  }
});
$('btnNewKey').onclick = async ()=>{
  const name = $('nk_name').value.trim()||'子卡';
  const quota = Number($('nk_quota').value)||0;
  const models = $('nk_models').value.split(',').map(s=>s.trim()).filter(Boolean);
  try {
    const r = await api('auth/mykeys',{method:'POST',body:{name, quotaTokens:quota, models}});
    toast('已签发: '+(r.key&&r.key.key||'').slice(0,14)+'…');
    $('nk_name').value=''; $('nk_quota').value=''; $('nk_models').value='';
    loadKeys(); loadHome();
  } catch(e){ toast(e.message, true); }
};
async function loadPlugins(){
  try {
    const r = await fetch(apiBase+'plugins', {headers:{'Accept':'application/json'}}).then(r=>r.json());
    const list = (r.plugins||[]).filter(p=>p.userPage);
    if (!list.length) return;
    $('tabPlugins').hidden = false;
    $('pluginCards').innerHTML = '<h3>插件</h3>' + list.map(p=>
      '<div class="mrow"><div style="font-size:20px">'+(p.icon||'<span class="msym" style="font-size:18px">extension</span>')+'</div><div class="grow"><div style="font-weight:600">'+esc(p.name)+'</div><div class="sub">'+esc(p.description||'')+'</div></div><button class="btn btn-tonal btn-sm" data-pp="'+esc(p.id)+'" data-pg="'+esc(p.userPage)+'">打开</button></div>'
    ).join('');
  } catch(_){}
}
$('pluginCards').addEventListener('click', e=>{
  const b = e.target.closest('[data-pp]'); if(!b) return;
  $('pluginFrameBox').hidden = false;
  $('pluginFrame').src = apiBase + 'plugins/' + b.getAttribute('data-pp') + '/' + b.getAttribute('data-pg');
  $('pluginFrameBox').scrollIntoView({behavior:'smooth'});
});

/* ---------- boot ---------- */
checkRegInfo();
if (token) { api('credits').then(()=>enter()).catch(()=>{ token=''; localStorage.removeItem('agw_user_token'); }); }
</script>
</body>
</html>
